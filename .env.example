# Na VPS o deploy (.github/workflows/deploy-vps.yml) cria este arquivo sozinho
# em /opt/techsupport/.env, com senhas aleatórias. Para rodar localmente:
#   cp .env.example .env

# URL pública do sistema (links de avaliação enviados pelo WhatsApp)
APP_URL=https://suporte.redeg7.com

# Porta local do app (só 127.0.0.1). 5001 é do Honorários Control
APP_PORT=5002

# Senha do banco PostgreSQL (openssl rand -hex 24)
POSTGRES_PASSWORD=

# Segredo das sessões de login (openssl rand -hex 32)
SESSION_SECRET=

# Chatbot / IA - opcional
ANTHROPIC_API_KEY=

# E-mail - opcional
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
